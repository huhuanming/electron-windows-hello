{
  "name": "electron-windows-hello",
  "version": "0.1.0",
  "description": "Window-owned Windows Hello verification for Electron, with x64 and ARM64 prebuilds",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "electron-windows-hello.win32-x64-msvc.node",
    "electron-windows-hello.win32-arm64-msvc.node"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "test:electron": "electron test/electron.cjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --module node16 --moduleResolution node16 test/types.ts",
    "prepack": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huhuanming/electron-windows-hello.git"
  },
  "bugs": "https://github.com/huhuanming/electron-windows-hello/issues",
  "homepage": "https://github.com/huhuanming/electron-windows-hello#readme",
  "keywords": [
    "electron",
    "windows-hello",
    "biometrics",
    "windows",
    "arm64"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
